# Python cache
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/

# IDE settings
.vscode/
.idea/

# Operating system files
.DS_Store
Thumbs.db
desktop.ini

# Generated analysis output
output/*
!output/.gitkeep

# Downloaded MEDA datasets
input/*
!input/.gitkeep

# Logs
*.log

# Temporary files
*.tmp
*.bak

# Test input and output directories
/input_test/
/output_test/

# Local testing data - do not upload to GitHub
/z__________/

# Ignore everything inside performance except the test script.
/performance/*
!/performance/performance_test.py

# Local user data - never upload personal data or analysis runs
/user_data/runs/*
!/user_data/runs/.gitkeep

/user_data/logs/*
!/user_data/logs/.gitkeep

/user_data/settings/*
!/user_data/settings/.gitkeep
