<?xml version="1.0" encoding="UTF-8"?>
<Product>
    <logical_identifier>
        urn:example:meda:test:sol100:ats
    </logical_identifier>
    <title>Synthetic MEDA ATS Integration Fixture</title>

    <Table_Delimited>
        <records>3</records>
        <record_length>32</record_length>
        <field_delimiter>,</field_delimiter>
        <record_delimiter>Line-Feed</record_delimiter>

        <Field_Delimited>
            <name>LMST</name>
            <field_number>1</field_number>
            <data_type>ASCII_String</data_type>
            <description>Local mean solar time coordinate</description>
            <unit>hh:mm:ss</unit>
        </Field_Delimited>

        <Field_Delimited>
            <name>Temperature</name>
            <field_number>2</field_number>
            <data_type>ASCII_Real</data_type>
            <description>Example temperature measurement</description>
            <unit>degC</unit>
            <Special_Constants>
                <valid_minimum>-100</valid_minimum>
                <valid_maximum>100</valid_maximum>
            </Special_Constants>
        </Field_Delimited>

        <Field_Delimited>
            <name>Quality_Flag</name>
            <field_number>3</field_number>
            <data_type>ASCII_Integer</data_type>
            <description>Quality flag candidate field</description>
            <unit>1</unit>
            <Special_Constants>
                <valid_minimum>0</valid_minimum>
                <valid_maximum>255</valid_maximum>
            </Special_Constants>
        </Field_Delimited>
    </Table_Delimited>
</Product>